# Directory where JSONL scrape output is appended.
DATA_DIR=./data

# Optional. Leave empty locally to skip metric publishing.
# For k3s/VictoriaMetrics this can be set to something like:
# http://victoria-victoria-metrics-single-server.metrics.svc.cluster.local:8428/opentelemetry/v1/metrics
OTEL_EXPORTER_OTLP_ENDPOINT=
